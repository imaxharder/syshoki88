function updateCountdown(id, times){
  const el=document.getElementById(id);
  setInterval(()=>{
    const now=new Date();
    let nextTime=null;
    for(let t of times){
      const [h,m]=t.split(':');
      const target=new Date();
      target.setHours(parseInt(h),parseInt(m),0,0);
      if(target>now){
        nextTime=target;
        break;
      }
    }
    if(!nextTime){ // kalau semua target lewat, ambil yang pertama besok
      const [h,m]=times[0].split(':');
      const target=new Date();
      target.setDate(target.getDate()+1);
      target.setHours(parseInt(h),parseInt(m),0,0);
      nextTime=target;
    }
    const diff=Math.max(0,nextTime-now);
    const hours=Math.floor(diff/1000/60/60);
    const minutes=Math.floor(diff/1000/60)%60;
    const seconds=Math.floor(diff/1000)%60;
    el.textContent=`${String(hours).padStart(2,'0')}:${String(minutes).padStart(2,'0')}:${String(seconds).padStart(2,'0')}`;
  },1000);
}

// Jalankan untuk semua slot
for(let id in schedules){
  updateCountdown(id,schedules[id]);
}
